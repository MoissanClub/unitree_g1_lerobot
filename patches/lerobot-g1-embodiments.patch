+++ b/src/lerobot/robots/unitree_g1/g1_runtime.py
@@ -0,0 +1,61 @@
+"""Embodiment selection for the shared Unitree G1 robot implementation."""
+from dataclasses import dataclass
+from enum import IntEnum
+from typing import Callable
+
+
+@dataclass(frozen=True)
+class G1RuntimeSpec:
+    name: str
+    joint_index: type[IntEnum]
+    arm_index: type[IntEnum]
+    kp: tuple[float, ...]
+    kd: tuple[float, ...]
+    make_ik: Callable
+    make_simulation: Callable | None = None
+    hardware_supported: bool = False
+    supports_controller: bool = False
+    model_resource: str = ""
+    default_positions: tuple[float, ...] = (0.0,) * 29
+
+
+_SPECS: dict[str, G1RuntimeSpec] = {}
+
+
+def register_g1_embodiment(spec: G1RuntimeSpec) -> None:
+    if spec.name in _SPECS:
+        raise ValueError(f"G1 embodiment already registered: {spec.name}")
+    indices = {int(j) for j in spec.joint_index}
+    if not indices or not indices <= set(range(29)):
+        raise ValueError("G1 joint indices must use the 29-slot transport layout")
+    if not {int(j) for j in spec.arm_index} <= indices:
+        raise ValueError("Arm indices must be active robot joints")
+    if len(spec.kp) != 29 or len(spec.kd) != 29:
+        raise ValueError("G1 gains must use the 29-slot transport layout")
+    _SPECS[spec.name] = spec
+
+
+def _make_g1_29_ik():
+    from .unitree_g1 import G1_29_ArmIK
+    return G1_29_ArmIK()
+
+
+def _make_g1_29_simulation():
+    from lerobot.envs import make_env
+    wrapper = make_env("lerobot/unitree-g1-mujoco", trust_remote_code=True)
+    return wrapper, wrapper["hub_env"][0].envs[0]
+
+
+def get_g1_embodiment(name: str) -> G1RuntimeSpec:
+    if name == "g1_29" and name not in _SPECS:
+        from .config_unitree_g1 import _DEFAULT_KP, _DEFAULT_KD
+        from .g1_utils import G1_29_JointArmIndex, G1_29_JointIndex
+        register_g1_embodiment(G1RuntimeSpec(
+            name, G1_29_JointIndex, G1_29_JointArmIndex, tuple(_DEFAULT_KP), tuple(_DEFAULT_KD),
+            _make_g1_29_ik, _make_g1_29_simulation, True, True,
+            model_resource="lerobot/unitree-g1-mujoco",
+        ))
+    try:
+        return _SPECS[name]
+    except KeyError as exc:
+        raise ValueError(f"Unknown/unregistered G1 embodiment: {name}") from exc
